{
  "name": "okey-playable",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Okey tile game for YouTube Playables",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "build:web": "tsc --noEmit && vite build --mode web --outDir dist-web",
    "package:web": "npm run build:web && node scripts/package.mjs web",
    "assets": "npm run build && node scripts/shoot-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config vitest.timing.config.ts",
    "test:unit": "vitest run",
    "bench:bots": "vitest run --config vitest.bench.config.ts",
    "check:layout": "npm run build:web && node scripts/layout-check.mjs",
    "check:ui": "npm run build:web && node scripts/ui-smoke.mjs",
    "check:pwa": "npm run build:web && node scripts/pwa-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
